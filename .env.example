# Arc testnet
ARC_RPC_URL=https://rpc.testnet.arc.network
USDC_ADDRESS=0x3600000000000000000000000000000000000000
FACTORY_ADDRESS=
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.arc.io

# Wallets (testnet only). Client funds work orders, agent pays from vaults,
# seller sells data and settles x402 authorizations.
DEPLOYER_PRIVATE_KEY=
CLIENT_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
SELLER_PRIVATE_KEY=
SELLER_ADDRESS=
MIRROR_ADDRESS=

# Arc mainnet (real USDC), alongside testnet. Off until MAINNET_FACTORY_ADDRESS and the
# three role keys are set. Use separate keys from testnet; fund each with a little USDC
# (gas is paid in USDC). Deploy the factory with: npm run deploy:mainnet
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
MAINNET_FACTORY_ADDRESS=
MAINNET_DEPLOYER_PRIVATE_KEY=
MAINNET_CLIENT_PRIVATE_KEY=
MAINNET_AGENT_PRIVATE_KEY=
MAINNET_SELLER_PRIVATE_KEY=
# Most one mainnet job may hold, in USD
MAINNET_MAX_JOB_USD=5
# Gateway top-ups for marketplace purchases on mainnet (USDC)
GATEWAY_TOPUP_MAINNET=0.5
GATEWAY_DAILY_CAP_MAINNET=2

# Arc Onramp (buy USDC with a card). Testnet uses the sandbox with CIRCLE_API_KEY;
# mainnet needs a production key from the Circle Console (and KYB for card payments).
CIRCLE_MAINNET_API_KEY=

# Where the agent reaches the x402 data service
APP_URL=http://localhost:3000

# Optional
REAPPROVAL_TIMEOUT_MS=120000
ALLOW_FAULTS=true

# Circle developer-controlled wallets (agent signs vault calls, seller settles x402)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_AGENT_WALLET_ID=
CIRCLE_AGENT_ADDRESS=
CIRCLE_SELLER_WALLET_ID=
CIRCLE_SELLER_ADDRESS=
CIRCLE_MIRROR_WALLET_ID=
CIRCLE_MIRROR_ADDRESS=

# MCP access token (required when hosted)
MCP_TOKEN=
APP_PUBLIC_URL=

# AI planner (OpenAI-compatible; Gemini by default)
AI_API_KEY=
# low (default) = faster, fewer hidden thinking tokens; medium, high, or "default" for the model's own setting
# AI_REASONING_EFFORT=low
AI_MODEL=gemini-flash-latest
AI_FALLBACK_MODEL=gemini-flash-lite-latest

# Hosting
DATA_DIR=/data
LIVE_ACCESS_CODE=

# Circle modular wallets (user passkey wallets). Browser-safe key bound to your domain.
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=
NEXT_PUBLIC_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
FAUCET_DAILY_LIMIT_USDC=10

# Optional: Gemini sandbox trading (orders are paper trades without these)
GEMINI_TRADING_KEY=
GEMINI_TRADING_SECRET=
# GEMINI_TRADING_ENV=production
# MAX_ORDER_USD=50

# Marketplace nanopayments: the agent keeps a small USDC balance in Circle Gateway.
# GATEWAY_MIN_BALANCE=0.05
# GATEWAY_TOPUP=1
# Most it tops up on its own in 24h (USDC).
# GATEWAY_DAILY_CAP=3

# Write a hash of each placed exchange order to Arc from the agent wallet (live mode). false to turn off.
# ANCHOR_ORDERS=true
# Jobs that run at once; more wait their turn.
# MAX_ACTIVE_JOBS=8

# The network marketplace purchases are paid on (default Arc testnet, eip155:5042002).
# MARKETPLACE_NETWORK=eip155:5042002
# Most one marketplace request may cost, in USDC base units (default 10000 = 0.01 USDC).
# MARKETPLACE_MAX_PER_REQUEST=10000
